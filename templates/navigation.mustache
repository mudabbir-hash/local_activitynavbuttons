{{!
    @template local_activitynavbuttons/navigation

    Previous, next, and back-to-course links shown at the bottom of an activity page.

    Context variables required for this template:
    * navigationlabel - Accessible name for the navigation landmark.
    * previous - Optional link object.
    * next - Optional link object.
    * backtocourse - Optional link object. When present, debugtext on this same object is rendered beside the link.
    * debugtext - Plain-text diagnostic. Escaped by the template. Always set for this release, including when the debug setting is off. Printed in the course slot, in the same section as Back to course.

    Each link object:
    * url - Destination href.
    * text - Visible label.
    * arialabel - Accessible name, including the activity name when it is known.
    * classes - Button classes.
    * newtab - When true, target="_blank" and rel="noopener noreferrer".
    * debugtext - On backtocourse only. The diagnostic printed beside that button.

    Example context (json):
    {
        "navigationlabel": "Activity navigation",
        "previous": {
            "url": "https://example.com/mod/page/view.php?id=2&forceview=1",
            "text": "Previous: Introduction",
            "arialabel": "Previous activity: Introduction",
            "classes": "btn btn-outline-primary",
            "newtab": false
        },
        "backtocourse": {
            "url": "https://example.com/course/view.php?id=4",
            "text": "Back to course",
            "arialabel": "Back to course",
            "classes": "btn btn-outline-primary",
            "newtab": false,
            "debugtext": "plugin version: 2026111705\npagetype: mod-page-view\ncmid: 4\nmodname: page\nsequence count: 3\ncurrent found: yes\nprevious: id 2 name Introduction\nnext: id 3 name Summary\nshowprevious: saved \"1\" (on)\nshownext: saved \"1\" (on)\npreviousurl: empty\nnexturl: empty"
        },
        "debugtext": "plugin version: 2026111705",
        "next": {
            "url": "https://example.com/mod/page/view.php?id=3&forceview=1",
            "text": "Next: Summary",
            "arialabel": "Next activity: Summary",
            "classes": "btn btn-outline-primary",
            "newtab": false
        }
    }
}}
<nav class="local-activitynavbuttons" role="navigation" aria-label="{{navigationlabel}}">
    <div class="local-activitynavbuttons-slot local-activitynavbuttons-previous">
        {{#previous}}
            <a class="{{classes}}" href="{{url}}" aria-label="{{arialabel}}"{{#newtab}} target="_blank" rel="noopener noreferrer"{{/newtab}}>
                <svg class="local-activitynavbuttons-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                    <path d="M10.5 3.5L5.5 8l5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span>{{text}}</span>
            </a>
        {{/previous}}
    </div>
    <div class="local-activitynavbuttons-slot local-activitynavbuttons-course">
        {{#backtocourse}}
            <a class="{{classes}}" href="{{url}}" aria-label="{{arialabel}}"{{#newtab}} target="_blank" rel="noopener noreferrer"{{/newtab}}>
                <span>{{text}}</span>
            </a>
            <div class="local-activitynavbuttons-debug">{{debugtext}}</div>
        {{/backtocourse}}
        {{^backtocourse}}
            <div class="local-activitynavbuttons-debug">{{debugtext}}</div>
        {{/backtocourse}}
    </div>
    <div class="local-activitynavbuttons-slot local-activitynavbuttons-next">
        {{#next}}
            <a class="{{classes}}" href="{{url}}" aria-label="{{arialabel}}"{{#newtab}} target="_blank" rel="noopener noreferrer"{{/newtab}}>
                <span>{{text}}</span>
                <svg class="local-activitynavbuttons-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                    <path d="M5.5 3.5L10.5 8l-5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
            </a>
        {{/next}}
    </div>
</nav>
